# Pulse configuration (copy to .env and adjust)
# All optional - unset values fall back to the zero-setup prototype stores.

# Redis fan-in + TTL cooldowns (backend + agents)
PULSE_REDIS_URL=redis://localhost:6379/0

# PostgreSQL/TimescaleDB audit trail + metrics
PULSE_DB_DSN=postgresql://pulse:pulse@localhost:5432/pulse
PULSE_METRICS_DSN=postgresql://pulse:pulse@localhost:5432/pulse

# Action executor: simulated (default, no side effects) | docker
PULSE_EXECUTOR=simulated

# Telemetry cadence (seconds) used by the C++/Python agents
PULSE_INTERVAL_SECS=3

# Frontend overrides (Vite env, set at build time in frontend/.env.local)
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000
